# Copiar a .env.development para desarrollo local
# Proxy Vite → Gateway YARP :5050
VITE_API_URL=/api/v1
VITE_IDENTITY_URL=/api/v1
VITE_AUTH_URL=/api/v1/auth
VITE_CHAT_HUB_URL=/hubs/chat
VITE_CALLS_HUB_URL=/hubs/calls
VITE_RECOGNITION_URL=/recognition-api
VITE_LIVEKIT_URL=ws://localhost:7880
VITE_APP_NAME=SignTrack
VITE_APP_VERSION=1.0.0
VITE_ENVIRONMENT=development

# false = login normal | true = bypass auth solo UI (dev)
# NUNCA activar en build de producción — el guard de código ya lo fuerza a false en modo PROD
VITE_AUTH_DISABLED=false
