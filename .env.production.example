# SignTrack — variables build producción (VPS)
# El script pnpm deploy:prod inyecta VITE_LIVEKIT_URL automáticamente.
# Si despliegas frontend aparte (Vercel), configura estas en el panel de Vercel.

# Misma URL del VPS (recomendado: todo en un dominio — no hace falta cambiar nada)
# VITE_API_URL=/api/v1
# VITE_LIVEKIT_URL=wss://app.tudominio.gt/livekit

# Solo si frontend en Vercel y API en VPS:
# VITE_API_URL=https://app.tudominio.gt/api/v1
# VITE_CHAT_HUB_URL=https://app.tudominio.gt/hubs/chat
# VITE_CALLS_HUB_URL=https://app.tudominio.gt/hubs/calls
# VITE_RECOGNITION_URL=https://app.tudominio.gt/recognition-api
# VITE_LIVEKIT_URL=wss://app.tudominio.gt/livekit
